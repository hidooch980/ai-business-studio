[Unit]
Description=Encrypted AI Business Studio PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=abs-backup
Group=abs-backup
EnvironmentFile=/etc/ai-business-studio/backup.env
ExecStart=/opt/ai-business-studio/scripts/backup-postgres.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ai-business-studio
