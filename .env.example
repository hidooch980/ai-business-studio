APP_NAME=AI Business Studio
APP_ENV=development
LOG_LEVEL=INFO
# PostgreSQL for shared/multi-user deployments; SQLite only for single-node local use.
# DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/ai_business_studio

# Authentication: registration is intentionally disabled unless explicitly enabled.
ALLOW_PUBLIC_REGISTRATION=false
SESSION_COOKIE_NAME=abs_session
CSRF_COOKIE_NAME=abs_csrf
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_SECONDS=43200
# Generate a unique random secret of at least 32 characters for production.
AUTH_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOCK_SECONDS=900
# Compose deployment variables (replace every placeholder before deployment)
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
APP_DB_PASSWORD=replace-with-a-long-random-app-password
MIGRATOR_DB_PASSWORD=replace-with-a-long-random-migrator-password
DATABASE_URL=postgresql+psycopg://abs_app:replace-with-a-long-random-app-password@db:5432/ai_business_studio
MIGRATION_DATABASE_URL=postgresql+psycopg://abs_migrator:replace-with-a-long-random-migrator-password@db:5432/ai_business_studio
